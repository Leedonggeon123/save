       <item><widget class="QGroupBox" name="settingsCard"><property name="title"><string>메일 내용 자동 맞춤 설정</string></property><layout class="QFormLayout" name="settingsForm"><property name="horizontalSpacing"><number>24</number></property><property name="verticalSpacing"><number>16</number></property><item row="0" column="0"><widget class="QLabel" name="defaultSenderLabel"><property name="text"><string>기본 발신 이메일</string></property></widget></item><item row="0" column="1"><widget class="QLineEdit" name="defaultSenderEdit"><property name="placeholderText"><string>예: user@jewel.cloud</string></property></widget></item><item row="1" column="0"><widget class="QLabel" name="autoFitCharsLabel"><property name="text"><string>자동 맞춤 글자 수</string></property></widget></item><item row="1" column="1"><widget class="QLineEdit" name="autoFitCharsEdit"><property name="placeholderText"><string>예: 100</string></property></widget></item><item row="2" column="0"><widget class="QLabel" name="autoFitSentenceLabel"><property name="text"><string>자동 맞춤 문장</string></property></widget></item><item row="2" column="1"><widget class="QLineEdit" name="autoFitSentenceEdit"><property name="placeholderText"><string>자동으로 입력할 문장</string></property></widget></item><item row="3" column="0"><widget class="QLabel" name="prefixLabel"><property name="text"><string>메일 앞 기본 문구</string></property></widget></item><item row="3" column="1"><widget class="QLineEdit" name="prefixEdit"><property name="placeholderText"><string>메일 앞에 자동으로 입력할 문구</string></property></widget></item><item row="4" column="0"><widget class="QLabel" name="suffixLabel"><property name="text"><string>메일 뒤 기본 문구</string></property></widget></item><item row="4" column="1"><widget class="QLineEdit" name="suffixEdit"><property name="placeholderText"><string>메일 뒤에 자동으로 입력할 문구</string></property></widget></item><item row="5" column="0"><widget class="QLabel" name="downloadPathLabel"><property name="text"><string>다운로드 위치</string></property></widget></ite