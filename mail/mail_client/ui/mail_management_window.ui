      <item><layout class="QHBoxLayout" name="searchLayout"><item><widget class="QLineEdit" name="searchEdit"><property name="placeholderText"><string>보낸 사람, 받는 사람, 제목, 내용 검색</string></property></widget></item><item><widget class="QPushButton" name="searchButton"><property name="text"><string>검색</string></property></widget></item><item><widget class="QPushButton" name="clearSearchButton"><property name="text"><string>검색 초기화</string></property></widget></item></layout></item>
