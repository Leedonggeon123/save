    <item><layout class="QHBoxLayout" name="brandLayout"><property name="spacing"><number>10</number></property><item><widget class="QLabel" name="logoLabel"><property name="minimumSize"><size><width>42</width><height>32</height></size></property><property name="maximumSize"><size><width>42</width><height>32</height></size></property><property name="text"><string/></property><property name="scaledContents"><bool>true</bool></property></widget></item><item><widget class="QLabel" name="brandLabel"><property name="text"><string>Mail</string></property><property name="styleSheet"><string>color:#17324d;font-size:22px;font-weight:700;</string></property></widget></item><item><spacer name="brandSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item><item><widget class="QPushButton" name="mailSettingsButton"><property name="text"><string>메일 설정</string></property><property name="toolTip"><string>메일 설정과 블랙리스트 관리로 이동</string></property></widget></item></layout></item>
