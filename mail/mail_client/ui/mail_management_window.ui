<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MailManagementWindow</class>
 <widget class="QMainWindow" name="MailManagementWindow">
 <property name="windowTitle"><string>Jewel Cloud - 메일</string></property>
  <property name="minimumSize"><size><width>1020</width><height>820</height></size></property>
  <property name="styleSheet"><string notr="true">
QMainWindow{background:#f4f7fb;color:#1f2937;font-family:"Segoe UI","Malgun Gothic"}
QLabel#pageTitle{color:#14213d;font-size:28px;font-weight:700}
QLabel#pageSubtitle{color:#6b7a90;font-size:13px}
QLabel#folderTitleLabel{background:#e8f3fb;color:#17324d;border:1px solid #cfe4f2;border-radius:6px;padding:10px;font-size:16px;font-weight:700}
QTabWidget::pane{background:#ffffff;border:1px solid #dce5ee;border-radius:10px}
QTabBar::tab{background:#eaf3f9;color:#5d6b7c;border:0;border-bottom:1px solid #d7e5ef;padding:12px 18px;min-width:130px;text-align:left}
QTabBar::tab:first{border-top-left-radius:9px}
QTabBar::tab:selected{background:#ffffff;color:#1976b9;font-weight:700;border-left:4px solid #56b4e9;padding-left:14px}
QPushButton{background:#ffffff;color:#31465b;border:1px solid #cbd9e5;border-radius:6px;padding:8px 14px;min-height:18px}
QPushButton:hover{background:#edf8fe;border-color:#73bde4}
QPushButton:pressed{background:#d9f0fb}
QPushButton#composeButton,QPushButton#saveSettingsButton,QPushButton#addBlacklistButton{background:#2497d0;color:white;border:0;font-weight:700}
QPushButton#composeButton:hover,QPushButton#saveSettingsButton:hover,QPushButton#addBlacklistButton:hover{background:#147eb4}
QPushButton#deleteMailButton,QPushButton#removeBlacklistButton{background:#fff4f4;color:#b42318;border-color:#efb2b2}
QTableWidget{background:#ffffff;color:#25364a;border:1px solid #dce5ee;border-radius:6px;gridline-color:#edf1f5;alternate-background-color:#f8fbfd;selection-background-color:#d9f0fb;selection-color:#14213d}
QHeaderView::section{background:#f1f6fa;color:#526579;border:0;border-bottom:1px solid #dce5ee;padding:10px;font-weight:700}
QTableWidget::item{padding:6px}
QLineEdit,QTextEdit{background:#ffffff;color:#25364a;border:1px solid #cbd9e5;border-radius:6px;padding:9px}
QLineEdit:focus,QTextEdit:focus{border:2px solid #73bde4;padding:8px}
QGroupBox{background:#ffffff;border:1px solid #dce5ee;border-radius:8px;padding:18px;margin-top:12px;color:#31465b;font-weight:700}
QGroupBox::title{subcontrol-origin:margin;left:14px;padding:0 6px;background:#ffffff}
QCheckBox{color:#31465b;padding:6px}
QLabel#statusLabel,QLabel#settingsStatusLabel,QLabel#blacklistStatusLabel{color:#587086;padding:6px}
   </string></property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="rootLayout">
